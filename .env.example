# Copia este archivo a .env y pide las keys reales al compañero que configuró el proyecto.
# Nunca subas .env a GitHub.

# --- Google Gemini (ADK) ---
GOOGLE_API_KEY=
GOOGLE_GENAI_USE_VERTEXAI=false
GEMINI_MODEL=gemini-3.5-flash-lite

# --- Supabase ---
SUPABASE_PROJECT_REF=
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=
# Si falla DNS IPv6, usa el pooler de sesion:
# postgresql://postgres.<PROJECT_REF>:<DB_PASSWORD>@aws-0-<REGION>.pooler.supabase.com:5432/postgres?sslmode=require
DB_PASSWORD=
